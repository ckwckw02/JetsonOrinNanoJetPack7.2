export LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8 LANGUAGE=en_US.UTF-8

safe_apt_install "sudo apt-get install -y curl" 5
sudo systemctl stop docker 2>/dev/null || true
sudo systemctl stop containerd 2>/dev/null || true
# Remove conflicting packages
echo Remove conflicting packages
echo 'for pkg in docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc; do sudo apt-get remove -qq -y $pkg || true; done'
for pkg in docker.io docker-doc docker-compose docker-compose-v2 podman-docker containerd runc; do sudo apt-get remove -qq -y $pkg || true; done

# Remove old docker packages
echo 'Remove old docker packages'
echo 'for pkg in docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker-ce-rootless-extras; do sudo apt-get remove -qq -y $pkg || true; done'
for pkg in docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker-ce-rootless-extras; do sudo apt-get remove -qq -y $pkg || true; done

DOCKER_APT_REPO="https://download.docker.com/linux/ubuntu"
if [[ -n '{{VAR_DOCKER_APT_REPO}}' && '{{VAR_DOCKER_APT_REPO}}' != '{{'VAR_DOCKER_APT_REPO'}}' ]]; then
  DOCKER_APT_REPO='{{VAR_DOCKER_APT_REPO}}'
  ## Remove trailing slash if any
  DOCKER_APT_REPO=${DOCKER_APT_REPO%/}
  echo "Set DOCKER_APT_REPO to ${DOCKER_APT_REPO}"
fi
# Add Docker's official GPG key:
safe_apt_install "sudo apt-get update" 5
sudo install -m 0755 -d /etc/apt/keyrings
curl -fsSL ${DOCKER_APT_REPO}/gpg | sudo gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
sudo chmod a+r /etc/apt/keyrings/docker.gpg

# Add the repository to Apt sources:
echo \
  "deb [arch="$(dpkg --print-architecture)" signed-by=/etc/apt/keyrings/docker.gpg] ${DOCKER_APT_REPO} \
  "$(. /etc/os-release && echo "$VERSION_CODENAME")" stable" | \
  sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
safe_apt_install "sudo apt-get update" 5
safe_apt_install "sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin" 5

echo Docker service installed
